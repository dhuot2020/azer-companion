NODE_ENV=production
PORT=3030

# URL publique; elle doit aussi etre declaree dans le portail developpeur Blizzard.
BATTLENET_CLIENT_ID=change-me
BATTLENET_CLIENT_SECRET=change-me
BATTLENET_REGION=us
BATTLENET_LOCALE=fr_FR
BATTLENET_REDIRECT_URI=https://azer.example.com/api/auth/battlenet/callback
BATTLENET_LOGIN_SUCCESS_URL=/

# open: tout compte Battle.net; allowlist: famille seulement; closed: aucun nouveau compte.
REGISTRATION_MODE=allowlist
# Le # impose les guillemets dans un EnvironmentFile systemd.
ALLOWED_BATTLETAGS="VotreTag#1234,TagDeVotreSoeur#5678"

# Generer avec: openssl rand -base64 48
SESSION_SECRET=change-me
SESSION_COOKIE_NAME=azer.sid

# Generer avec: openssl rand -base64 32
OAUTH_ENCRYPTION_KEY=change-me

# PostgreSQL local au VPS. Ne pas exposer le port 5432 sur Internet.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=azer_compagnion
DB_USER=azer_app
DB_PASSWORD=change-me
DATABASE_SSL=false
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=10000

# Le VPS ne doit jamais lire le dossier WoW du serveur.
ENABLE_LOCAL_COLLECTOR=false
