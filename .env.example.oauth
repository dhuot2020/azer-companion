# ============================================================
# Battle.net OAuth - EXEMPLE
# Ne jamais committer les vraies valeurs.
# ============================================================

BATTLENET_CLIENT_ID=
BATTLENET_CLIENT_SECRET=
BATTLENET_REGION=us

# Local:
BATTLENET_REDIRECT_URI=http://localhost:3030/api/auth/battlenet/callback

# Apres mise en production:
# BATTLENET_REDIRECT_URI=https://azercompagnion.ca/api/auth/battlenet/callback

BATTLENET_LOGIN_SUCCESS_URL=/api/auth/me

SESSION_SECRET=
SESSION_COOKIE_NAME=azer.sid
