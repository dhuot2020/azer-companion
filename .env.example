# AzerCompagnion - local development
NODE_ENV=development
PORT=3030

# Battle.net OAuth
BATTLENET_CLIENT_ID=
BATTLENET_CLIENT_SECRET=
BATTLENET_REGION=us
BATTLENET_LOCALE=fr_FR
BATTLENET_REDIRECT_URI=http://localhost:3030/api/auth/battlenet/callback
BATTLENET_LOGIN_SUCCESS_URL=/

# Express session
SESSION_SECRET=

# MultiUser / PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=azercompanion
DB_USER=azercompanion
DB_PASSWORD=

# Le Collector local est reserve au developpement. En production, les donnees
# doivent arriver par le futur client Sync authentifie.
ENABLE_LOCAL_COLLECTOR=true
# Obligatoire si plusieurs utilisateurs existent et qu'un seul compte local
# doit conserver l'acces au fichier SavedVariables de cette machine.
LOCAL_COLLECTOR_USER_ID=
