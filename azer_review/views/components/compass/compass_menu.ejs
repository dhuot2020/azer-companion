<div class="compass-menu" id="compassMenu" aria-hidden="true">
  <button class="compass-menu-overlay" id="compassMenuOverlay" type="button" aria-label="Fermer la navigation" tabindex="-1"></button>

  <section class="compass-menu-panel" role="dialog" aria-modal="true" aria-labelledby="compassMenuTitle">
    <div class="compass-menu-glow" aria-hidden="true"></div>

    <header class="compass-menu-heading">
      <span class="compass-menu-kicker">NAVIGATION D’AZEROTH</span>
      <h2 id="compassMenuTitle">Choisis ta destination</h2>
      <p>La route est entre tes mains.</p>
    </header>

    <nav class="compass-wheel" id="compassWheel" aria-label="Navigation principale">
      <span class="compass-energy-field" aria-hidden="true"></span>

      <% const compassItems = [
        { key: 'monde', label: 'Monde', position: 'north', icon: 'globe' },
        { key: 'quetes', label: 'Quêtes', position: 'north-east', icon: 'scroll' },
        { key: 'donjons', label: 'Donjons', position: 'east', icon: 'swords' },
        { key: 'montures', label: 'Montures', position: 'south-east', icon: 'horse' },
        { key: 'collections', label: 'Collections', position: 'south', icon: 'chest' },
        { key: 'mascottes', label: 'Mascottes', position: 'south-west', icon: 'paw' },
        { key: 'journal', label: 'Journal', position: 'west', icon: 'book' },
        { key: 'personnage', label: 'Personnage', position: 'north-west', icon: 'hero' }
      ]; %>

      <% compassItems.forEach((item) => { %>
        <a class="compass-action compass-action-<%= item.position %>" href="#" data-compass-section="<%= item.key %>" data-compass-label="<%= item.label %>">
          <span class="compass-action-ray" aria-hidden="true"><i></i></span>
          <span class="compass-action-icon" aria-hidden="true">
            <% if (item.icon === 'globe') { %>
              <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8.5"/><path d="M3.8 9h16.4M3.8 15h16.4M12 3.5c2.1 2.3 3.1 5.1 3.1 8.5s-1 6.2-3.1 8.5M12 3.5C9.9 5.8 8.9 8.6 8.9 12s1 6.2 3.1 8.5"/></svg>
            <% } else if (item.icon === 'scroll') { %>
              <svg viewBox="0 0 24 24"><path d="M7 4.5h10a2 2 0 0 1 2 2V19H8a3 3 0 0 1-3-3V6.5a2 2 0 0 1 2-2Z"/><path d="M8 19a2.5 2.5 0 0 0 0-5H5M9 8h7M9 11h6"/></svg>
            <% } else if (item.icon === 'swords') { %>
              <svg viewBox="0 0 24 24"><path d="m5 4 7 7M3.5 2.5l3 1-2 2-1-3ZM12 11l7 7M16.5 18.5l2-2 2.5 2.5-2 2Z"/><path d="m19 4-7 7M20.5 2.5l-3 1 2 2 1-3ZM12 11l-7 7M7.5 18.5l-2-2L3 19l2 2Z"/></svg>
            <% } else if (item.icon === 'horse') { %>
              <svg viewBox="0 0 24 24"><path d="M6 20v-5l2-3-1-4 4-4 1.5 3L17 5l1 4-2 3 2 8M9 20v-4h6v4M10 10h.01"/></svg>
            <% } else if (item.icon === 'chest') { %>
              <svg viewBox="0 0 24 24"><path d="M4 8h16v11H4zM5 8l2-4h10l2 4M4 12h16M10 12v3h4v-3"/></svg>
            <% } else if (item.icon === 'paw') { %>
              <svg viewBox="0 0 24 24"><ellipse cx="12" cy="15.5" rx="5" ry="4"/><ellipse cx="6.5" cy="10" rx="2" ry="2.7"/><ellipse cx="17.5" cy="10" rx="2" ry="2.7"/><ellipse cx="9.5" cy="6.5" rx="1.8" ry="2.5"/><ellipse cx="14.5" cy="6.5" rx="1.8" ry="2.5"/></svg>
            <% } else if (item.icon === 'book') { %>
              <svg viewBox="0 0 24 24"><path d="M4 5.5A3.5 3.5 0 0 1 7.5 2H11v17H7.5A3.5 3.5 0 0 0 4 22Z"/><path d="M20 5.5A3.5 3.5 0 0 0 16.5 2H13v17h3.5A3.5 3.5 0 0 1 20 22Z"/></svg>
            <% } else { %>
              <svg viewBox="0 0 24 24"><circle cx="12" cy="7" r="3.5"/><path d="M5 21a7 7 0 0 1 14 0M8 13.5l-2-2M16 13.5l2-2"/></svg>
            <% } %>
          </span>
          <span class="compass-action-label"><%= item.label %></span>
        </a>
      <% }); %>

      <button class="compass-core" id="compassMenuClose" type="button" aria-label="Fermer la rose des vents">
        <span class="compass-core-halo" aria-hidden="true"></span>
        <span class="compass-core-ring" aria-hidden="true"></span>
        <img src="/assets/azer-compass.png" alt="" aria-hidden="true" />
        <span class="compass-core-text">FERMER</span>
      </button>
    </nav>

    <footer class="compass-menu-footer">
      <span>Échap pour fermer</span>
      <strong id="compassMenuStatus" aria-live="polite">Survole une destination</strong>
    </footer>
  </section>
</div>
