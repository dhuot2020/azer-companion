<%- include('partials/header') %>

<main class="addon-page">
  <section class="addon-panel">
    <header class="addon-header">
      <span class="addon-kicker">AZER COMPANION</span>
      <h1>Azer Companion Collector</h1>
      <p>
        Installe l’addon pour synchroniser automatiquement tes données
        World of Warcraft avec Azer Compagnion.
      </p>
    </header>

    <div class="addon-actions">
      <a
        href="#"
        class="addon-action addon-action-primary"
        id="curseForgeButton"
      >
        <span class="addon-action-icon">↓</span>

        <span>
          <strong>Installer avec CurseForge</strong>
          <small>Méthode recommandée</small>
        </span>

        <i></i>
      </a>

      <a
        href="/downloads/AzerCompanionCollector.zip"
        class="addon-action"
        download
      >
        <span class="addon-action-icon">⇩</span>

        <span>
          <strong>Installation manuelle</strong>
          <small>Télécharger le ZIP de l’addon</small>
        </span>

        <i></i>
      </a>
    </div>

    <section class="addon-instructions">
      <h2>Installation manuelle</h2>

      <ol>
        <li>
          Télécharge
          <strong>AzerCompanionCollector.zip</strong>.
        </li>

        <li>
          Décompresse le dossier
          <strong>AzerCompanionCollector</strong>
          dans :
          <code>World of Warcraft/_retail_/Interface/AddOns/</code>
        </li>

        <li>
          Lance World of Warcraft.
        </li>

        <li>
          Vérifie que
          <strong>Azer Companion Collector</strong>
          est activé dans la liste des addons.
        </li>

        <li>
          En jeu, utilise :
          <code>/azer scan</code>
        </li>

        <li>
          Puis :
          <code>/reload</code>
        </li>

        <li>
          Retourne sur Azer Compagnion et clique sur
          <strong>Synchroniser WoW</strong>.
        </li>
      </ol>
    </section>

    <footer class="addon-footer">
      <a href="/" class="addon-back">
        ← Retour à Azer Compagnion
      </a>
    </footer>
  </section>
</main>

<%- include('partials/footer') %>