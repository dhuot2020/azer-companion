<%- include('partials/header') %>

<div class="azer-shell">
  <aside class="side-menu" id="sideMenu">
    <div class="brand-block">
      <div class="brand-main brand-main-wordmark">
        <div class="brand-copy brand-copy-wordmark">
          <div class="brand-title">AZER</div>

          <div class="brand-divider" aria-hidden="true">
            <span></span>
            <i></i>
            <span></span>
          </div>

          <div class="brand-subtitle">COMPANION</div>
        </div>
      </div>

      <div class="brand-label brand-tagline">
        <span></span>
        <b>POUR WORLD OF WARCRAFT</b>
        <span></span>
      </div>
    </div>

    <nav class="main-nav" id="mainNav">
      <a href="#" class="nav-item active" data-view-target="dashboard">
        <span class="azer-nav-icon" aria-hidden="true"><svg><use href="#icon-home"></use></svg></span>
        <b>Accueil</b>
      </a>
      <a href="#" class="nav-item" id="hallHeroesNav">
        <span class="azer-nav-icon" aria-hidden="true"><svg><use href="#icon-shield"></use></svg></span>
        <b>Hall des héros</b>
      </a>
      <a href="#" class="nav-item" id="questsNav">
        <span class="azer-nav-icon" aria-hidden="true"><svg><use href="#icon-quest"></use></svg></span>
        <b>Quêtes</b>
      </a>
      <a href="#" class="nav-item">
        <span class="azer-nav-icon" aria-hidden="true"><svg><use href="#icon-journal"></use></svg></span>
        <b>Journal de bord</b>
      </a>
      <a href="#" class="nav-item">
        <span class="azer-nav-icon" aria-hidden="true"><svg><use href="#icon-trophy"></use></svg></span>
        <b>Réussites</b>
      </a>
      <a href="#" class="nav-item">
        <span class="azer-nav-icon" aria-hidden="true"><svg><use href="#icon-chest"></use></svg></span>
        <b>Collections</b>
      </a>
      <a href="#" class="nav-item">
        <span class="azer-nav-icon" aria-hidden="true"><svg><use href="#icon-chart"></use></svg></span>
        <b>Activités</b>
      </a>
      <a href="#" class="nav-item">
        <span class="azer-nav-icon" aria-hidden="true"><svg><use href="#icon-tools"></use></svg></span>
        <b>Outils</b>
      </a>
      <a href="#" class="nav-item">
        <span class="azer-nav-icon" aria-hidden="true"><svg><use href="#icon-settings"></use></svg></span>
        <b>Paramètres</b>
      </a>
    </nav>
    <section class="sidebar-faction" id="sidebarFaction" aria-label="Faction du dernier héros joué">
      <span class="sidebar-faction-kicker">DERNIER HÉROS JOUÉ</span>
      <div class="sidebar-faction-emblem-wrap">
        <img
          id="sidebar-faction-emblem"
          class="sidebar-faction-emblem"
          src="/assets/factions/azer-alliance.png"
          alt="Alliance"
        />
      </div>
      <strong id="sidebar-faction-name">ALLIANCE</strong>
    </section>

    <section class="sidebar-account" aria-label="Dernier personnage joué">
      <div class="sidebar-account-avatar">
        <img id="sidebar-account-avatar" alt="" hidden />
        <span id="sidebar-account-initial">D</span>
      </div>
      <div class="sidebar-account-copy">
        <span class="sidebar-account-label">PERSONNAGE ACTIF</span>
        <strong id="sidebar-account-name">Synchronisation...</strong>
        <small id="sidebar-account-details">Données Battle.net</small>
      </div>
      <span class="sidebar-account-status" title="Synchronisé"></span>
    </section>

    <a
      href="/auth/blizzard"
      class="character-switch battle-net-button is-offline"
      id="battleNetAuthButton"
      aria-label="Se connecter à Battle.net"
    >
      <img
        src="/assets/battlenet-logo.png"
        alt=""
        class="battle-net-logo"
        aria-hidden="true"
      />
    </a>

    <div class="sidebar-dh-studio" aria-label="Une création de DH Studio">
      <small>Une création de</small>
      <img src="/assets/dhstudio.png" alt="DH" />
      <span>STUDIO</span>
    </div>
  </aside>

  <button
    class="sidebar-handle"
    id="sidebarHandle"
    type="button"
    aria-expanded="true"
    aria-label="Réduire la navigation"
  >
    <span class="sidebar-handle-icon" aria-hidden="true">‹</span>
  </button>

  <main class="main-area">
    <section
      id="dashboardView"
      class="app-view app-view-active home-dashboard"
      data-view="dashboard"
    >
      <svg class="azer-icon-library" aria-hidden="true">
        <symbol id="icon-home" viewBox="0 0 24 24"><path d="M3 11.5 12 4l9 7.5V21h-6v-6H9v6H3z"/></symbol>
        <symbol id="icon-shield" viewBox="0 0 24 24"><path d="M12 2 20 5v6c0 5.4-3.4 9.1-8 11-4.6-1.9-8-5.6-8-11V5z"/><path d="M12 6v11M8.5 10h7"/></symbol>
        <symbol id="icon-journal" viewBox="0 0 24 24"><path d="M4 4h7a3 3 0 0 1 3 3v13a4 4 0 0 0-4-3H4zM20 4h-3a3 3 0 0 0-3 3v13a4 4 0 0 1 4-3h2z"/></symbol>
        <symbol id="icon-trophy" viewBox="0 0 24 24"><path d="M8 4h8v4c0 4-2 7-4 7s-4-3-4-7zM10 15v3M14 15v3M8 21h8M6 6H3v2c0 3 2 5 5 5M18 6h3v2c0 3-2 5-5 5"/></symbol>
        <symbol id="icon-chest" viewBox="0 0 24 24"><path d="M4 8h16v12H4zM3 8l2-4h14l2 4M4 12h16M10 12h4v4h-4z"/></symbol>
        <symbol id="icon-chart" viewBox="0 0 24 24"><path d="M4 20V10h4v10M10 20V4h4v16M16 20v-7h4v7"/></symbol>
        <symbol id="icon-tools" viewBox="0 0 24 24"><path d="m4 20 7-7M15 9l5-5M14 4l6 6M5 4l5 5-3 3-5-5zM13 14l7 7"/></symbol>
        <symbol id="icon-settings" viewBox="0 0 24 24"><path d="M12 8a4 4 0 1 1 0 8 4 4 0 0 1 0-8z"/><path d="M12 2v3M12 19v3M4.9 4.9 7 7M17 17l2.1 2.1M2 12h3M19 12h3M4.9 19.1 7 17M17 7l2.1-2.1"/></symbol>
        <symbol id="icon-heroes" viewBox="0 0 24 24"><path d="M8 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM16 10a3 3 0 1 0 0-6M2 21v-3c0-3 2.5-5 6-5s6 2 6 5v3M15 13c4 0 7 2 7 5v3h-5"/></symbol>
        <symbol id="icon-location" viewBox="0 0 24 24"><path d="M12 22s7-6.2 7-13A7 7 0 0 0 5 9c0 6.8 7 13 7 13z"/><circle cx="12" cy="9" r="2.5"/></symbol>
        <symbol id="icon-clock" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></symbol>
        <symbol id="icon-level" viewBox="0 0 24 24"><path d="m12 2 3 6 6 .8-4.5 4.4 1.1 6.3L12 16.5 6.4 19.5l1.1-6.3L3 8.8 9 8z"/></symbol>
        <symbol id="icon-quest" viewBox="0 0 24 24"><path d="m5 20 5-5M14 4l6 6-8 8-6-6zM15 3l2 2M4 17l3 3"/></symbol>
        <symbol id="icon-dungeon" viewBox="0 0 24 24"><path d="M5 21V8l7-5 7 5v13M9 21v-6h6v6M8 10h2M14 10h2"/></symbol>
        <symbol id="icon-map" viewBox="0 0 24 24"><path d="m3 6 6-3 6 3 6-3v15l-6 3-6-3-6 3zM9 3v15M15 6v15"/></symbol>
        <symbol id="icon-check" viewBox="0 0 24 24"><path d="m4 13 5 5L20 6"/></symbol>
        <symbol id="icon-arrow" viewBox="0 0 24 24"><path d="m9 5 7 7-7 7"/></symbol>
      </svg>

      <section class="home-hero">
        <div class="home-hero-overlay"></div>
        <div class="home-welcome">
          <span class="home-eyebrow">AZER COMPANION</span>
          <h1>BONJOUR <strong>DANIEL</strong> !</h1>
          <p>Bienvenue dans ton carnet d’aventure.</p>

          <div class="last-hero-label">DERNIER HÉROS JOUÉ</div>
          <div class="last-hero">
            <div class="last-hero-medallion" id="homeHeroMedallion" data-faction="ALLIANCE">
              <img class="last-hero-faction-frame" id="homeHeroFactionFrame" src="/assets/factions/azer-alliance.png" alt="" aria-hidden="true" />
              <div class="last-hero-avatar"><img id="homeHeroAvatar" alt="" hidden /></div>
            </div>
            <div class="last-hero-copy">
              <h2 id="homeHeroName">Synchronisation...</h2>
              <p><strong id="homeHeroClass">—</strong> · Niveau <span id="homeHeroLevel">—</span></p>
              <ul>
                <li><svg><use href="#icon-location"></use></svg><span id="homeHeroLocation">Lieu non enregistré</span></li>
                <li><svg><use href="#icon-clock"></use></svg><span id="homeHeroLastPlayed">Dernière session inconnue</span></li>
                <li><svg><use href="#icon-clock"></use></svg><span id="homeHeroDuration">Durée non enregistrée</span></li>
              </ul>
            </div>
          </div>
        </div>

        <aside class="account-overview">
          <h2>VUE D’ENSEMBLE DU COMPTE</h2>
          <ul>
            <li><svg><use href="#icon-heroes"></use></svg><strong id="accountCharactersCount">—</strong><span>Personnages</span></li>
            <li><svg><use href="#icon-level"></use></svg><strong id="accountLevelsTotal">—</strong><span>Niveaux cumulés</span></li>
            <li><svg><use href="#icon-journal"></use></svg><strong id="accountSessionsCount">—</strong><span>Sessions enregistrées</span></li>
            <li><svg><use href="#icon-map"></use></svg><strong id="accountZonesCount">—</strong><span>Zones explorées</span></li>
            <li><svg><use href="#icon-clock"></use></svg><strong id="accountWeekTime">—</strong><span>Temps de jeu cette semaine</span></li>
          </ul>
        </aside>
      </section>

      <section class="home-grid">
        <article class="home-panel journal-panel">
          <header><h2>JOURNAL DE BORD</h2><button type="button" id="viewFullJournalButton">Voir tout</button></header>
          <div class="timeline" id="homeTimeline">
            <div class="home-empty-state">
              <strong>Chargement du Journal de bord...</strong>
              <small>Les sessions réelles du Collector apparaîtront ici.</small>
            </div>
          </div>
        </article>

        <article class="home-panel achievements-panel">
          <header><h2>RÉUSSITES RÉCENTES</h2></header>
          <div id="homeAchievementsList" class="home-achievements-list">
            <div class="home-empty-state">
              <span class="achievement-icon"><svg><use href="#icon-trophy"></use></svg></span>
              <strong>Aucune réussite synchronisée</strong>
              <small>Les prochains hauts faits obtenus avec le Collector actif apparaîtront ici.</small>
            </div>
          </div>
        </article>

        <article class="home-panel objectives-panel">
          <header><h2>OBJECTIFS</h2></header>
          <div class="home-empty-state">
            <span class="achievement-icon"><svg><use href="#icon-quest"></use></svg></span>
            <strong>Aucun objectif configuré</strong>
            <small>Les objectifs personnels seront ajoutés dans une prochaine étape.</small>
          </div>
        </article>

        <article class="home-panel heroes-panel">
          <header><h2>MES HÉROS</h2><button type="button" id="viewAllHeroesButton">Voir tous mes héros</button></header>
          <div class="heroes-strip" id="homeHeroesStrip"></div>
        </article>

        <article class="home-panel activity-panel">
          <header><h2>ACTIVITÉ DU COMPTE</h2><span>Cette semaine</span></header>
          <div class="activity-stats">
            <div><svg><use href="#icon-clock"></use></svg><strong id="activityWeekTime">—</strong><small>Temps de jeu</small></div>
            <div><svg><use href="#icon-journal"></use></svg><strong id="activitySessionsCount">—</strong><small>Sessions</small></div>
            <div><svg><use href="#icon-map"></use></svg><strong id="activityZonesCount">—</strong><small>Zones connues</small></div>
            <div><svg><use href="#icon-heroes"></use></svg><strong id="activityHeroesCount">—</strong><small>Personnages</small></div>
          </div>
        </article>

        <article class="home-panel locations-panel">
          <header><h2>DERNIERS LIEUX VISITÉS</h2><button type="button">Voir la carte</button></header>
          <div class="locations-map">
            <div class="home-empty-state">
              <strong>Chargement des lieux...</strong>
              <small>Les emplacements réels du Collector apparaîtront ici.</small>
            </div>
          </div>
        </article>
      </section>
    </section>

    <section id="questsView" class="app-view quests-view" data-view="quests" aria-hidden="true">
      <section class="quests-panel quests-atlas" aria-labelledby="quests-title">
        <header class="quests-header quests-world-header">
          <div class="quests-title-wrap">
            <span class="quest-atlas-emblem" aria-hidden="true">
              <svg viewBox="0 0 64 64"><path d="M17 9h30v46H17z"/><path d="M22 14h20v30H22z"/><path d="M24 17l8 6 8-6v23l-8-6-8 6z"/><path d="M13 14h4v36h-4zM47 14h4v36h-4z"/></svg>
            </span>
            <div>
              <span class="characters-kicker">ATLAS D’AZEROTH</span>
              <h2 id="quests-title">Journal des quêtes</h2>
              <p>Explore Azeroth région par région et retrouve ce que ton héros a terminé, ce qu’il poursuit et ce qu’il lui reste à découvrir.</p>
            </div>
          </div>
          <div class="quests-actions">
            <div id="questsCharacterPicker" class="quests-character-picker">
              <button id="questsCharacterButton" class="quests-character-button" type="button" aria-haspopup="listbox" aria-expanded="false">
                <span class="quests-character-avatar"><img id="questsCharacterAvatar" src="" alt="" hidden></span>
                <span class="quests-character-copy">
                  <strong id="questsCharacterName">Personnage</strong>
                  <small id="questsCharacterRealm">Royaume</small>
                </span>
                <span class="quests-character-chevron" aria-hidden="true">
                  <svg viewBox="0 0 32 32" focusable="false">
                    <circle cx="16" cy="16" r="12.5" class="control-icon-ring"/>
                    <path d="m10.5 13.5 5.5 5 5.5-5" class="control-icon-glyph"/>
                  </svg>
                </span>
              </button>
              <div id="questsCharacterMenu" class="quests-character-menu" role="listbox" hidden></div>
              <select id="questsCharacterSelect" class="quests-select quests-character-native" aria-label="Personnage" tabindex="-1"></select>
            </div>
            <button id="questsRefreshButton" class="quests-refresh" type="button" aria-label="Actualiser les données">
              <span class="quests-refresh-label">Actualiser</span>
              <svg class="quests-refresh-icon" viewBox="0 0 32 32" aria-hidden="true">
                <circle cx="16" cy="16" r="12.5" class="control-icon-ring"/>
                <path d="M23.2 12.3A8 8 0 0 0 9.4 9.8L7.5 12M8.8 19.7a8 8 0 0 0 13.8 2.5l1.9-2.2" class="control-icon-glyph"/>
                <path d="M7.6 7.8V12h4.2M24.4 24.2V20h-4.2" class="control-icon-glyph"/>
              </svg>
            </button>
          </div>
        </header>

        <div class="quests-summary quests-summary-premium">
          <div class="quest-kpi">
            <span class="quest-kpi-icon quest-kpi-scroll" aria-hidden="true"><svg viewBox="0 0 48 48"><path d="M15 8h22v27H15z"/><path d="M10 12c0-3 2-5 5-5h3v6h-3c-3 0-5-1-5-1zM15 35h22v3c0 2-2 4-4 4H15c-3 0-5-2-5-5s2-5 5-5"/><path d="M21 17h10M21 22h10M21 27h7"/></svg></span>
            <div><strong id="questsActiveCount">0</strong><span id="questsActiveLabel">Quêtes en cours</span></div>
          </div>
          <div class="quest-kpi">
            <span class="quest-kpi-icon quest-kpi-check" aria-hidden="true"><svg viewBox="0 0 48 48"><circle cx="24" cy="24" r="15"/><path d="m16 24 6 6 11-13"/><path d="m24 4 3 5 6-2 1 6 6 1-2 6 5 3-5 4 2 6-6 1-1 6-6-2-3 6-4-6-6 2-1-6-6-1 2-6-5-4 5-3-2-6 6-1 1-6 6 2z"/></svg></span>
            <div><strong id="questsCompletedCount">0</strong><span id="questsCompletedLabel">Quêtes terminées</span></div>
          </div>
          <div class="quest-kpi">
            <span class="quest-kpi-icon quest-kpi-alert" aria-hidden="true"><svg viewBox="0 0 48 48"><circle cx="24" cy="24" r="15"/><path d="M24 14v13M24 33h.01"/><path d="m24 4 3 5 6-2 1 6 6 1-2 6 5 3-5 4 2 6-6 1-1 6-6-2-3 6-4-6-6 2-1-6-6-1 2-6-5-4 5-3-2-6 6-1 1-6 6 2z"/></svg></span>
            <div><strong id="questsObjectivesCount">0</strong><span id="questsObjectivesLabel">Objectifs à terminer</span></div>
          </div>
          <div class="quest-kpi">
            <span class="quest-kpi-icon quest-kpi-book" aria-hidden="true"><svg viewBox="0 0 48 48"><path d="M8 10h13c3 0 5 2 5 5v23c0-3-2-5-5-5H8zM40 10H27c-3 0-5 2-5 5v23c0-3 2-5 5-5h13z"/><path d="M13 17h7M13 22h7M28 17h7M28 22h7"/></svg></span>
            <div><strong id="questsAccountSharedCount">0</strong><span id="questsAccountSharedLabel">Quêtes à découvrir</span></div>
          </div>
        </div>

        <div class="quest-atlas-layout">
          <aside class="quest-atlas-column quest-continents-column">
            <div class="quest-column-title"><span>CONTINENTS</span></div>
            <nav id="questsContinentNav" class="quest-continent-nav" aria-label="Royaumes et continents"></nav>
          </aside>

          <aside class="quest-atlas-column quest-regions-column">
            <div class="quest-column-title"><span id="questsRegionsColumnTitle">RÉGIONS</span></div>
            <div id="questsRegionsGrid" class="quest-regions-grid"></div>
          </aside>

          <main class="quest-atlas-column quest-center-column">
            <section id="questsRegionDetail" class="quest-region-detail" hidden>
              <header class="quest-region-detail-head">
                <div class="quest-region-heading-copy">
                  <span class="quest-region-marker" aria-hidden="true">
                    <svg viewBox="0 0 36 36" focusable="false"><circle cx="18" cy="18" r="13"/><path d="M18 8v12M18 26h.01"/></svg>
                  </span>
                  <div>
                  <span id="questsRegionSubtitle">Azeroth</span>
                  <h3 id="questsRegionTitle">Région</h3>
                  </div>
                </div>
              </header>

              <div id="questsRegionHero" class="quest-region-hero">
                <div class="quest-region-hero-shade"></div>
                <div class="quest-region-hero-copy">
                  <span id="questsRegionProgressText">0 terminée · 0 en cours · 0 à faire</span>
                </div>
              </div>

              <div class="quest-region-progress-row">
                <span id="questsRegionCompletedText">0 / 0 quêtes terminées</span>
                <strong id="questsRegionPercent">0%</strong>
              </div>
              <div class="quest-region-detail-progress" aria-hidden="true"><i id="questsRegionProgressBar"></i></div>

              <div class="quest-status-filters" role="group" aria-label="Filtrer les quêtes">
                <button type="button" class="is-active" data-quest-status-filter="all"><span>Toutes</span><b id="questsFilterAllCount">0</b></button>
                <button type="button" data-quest-status-filter="active"><span>En cours</span><b id="questsFilterActiveCount">0</b></button>
                <button type="button" data-quest-status-filter="completed"><span>Terminées</span><b id="questsFilterCompletedCount">0</b></button>
                <button type="button" data-quest-status-filter="todo"><span>À faire</span><b id="questsFilterTodoCount">0</b></button>
              </div>

              <div class="quest-list-toolbar">
                <span id="questsListCount">Quêtes (0)</span>
                <span>Ordre de zone</span>
              </div>
              <div id="questsGrid" class="quests-grid quest-world-list"></div>
            </section>
          </main>

          <aside id="questDetailsPanel" class="quest-atlas-column quest-details-panel quest-details-docked" aria-live="polite" aria-labelledby="questDetailsTitle">
            <div id="questDetailsContent" class="quest-details-content">
              <div class="quest-details-empty">
                <span class="quest-details-empty-mark">?</span>
                <strong>Sélectionne une quête</strong>
                <p>Les objectifs, la description, les récompenses et les informations utiles apparaîtront ici.</p>
              </div>
            </div>
          </aside>
        </div>

        <div id="questDetailsBackdrop" class="quest-details-backdrop" hidden></div>
        <button id="questDetailsClose" class="quest-details-close quest-details-close-mobile" type="button" aria-label="Fermer les détails de la quête">×</button>


      </section>
    </section>

    <section
      id="charactersView"
      class="app-view characters-view"
      data-view="characters"
      aria-hidden="true"
    >
      <section class="characters-panel" aria-labelledby="characters-title">
        <header class="characters-header">
          <div class="characters-title-block">
            <button
              id="charactersHomeCompass"
              class="characters-title-icon"
              type="button"
              aria-label="Retourner au carnet d’aventure"
              title="Retour au carnet"
            >
              <img src="/assets/azer-compass.png" alt="" aria-hidden="true" />
            </button>

            <div>
              <span class="characters-kicker">AZER COMPANION</span>
              <h2 id="characters-title">Hall des héros</h2>
              <p>Choisis le personnage qui poursuivra ton aventure.</p>
            </div>
          </div>

          <div class="characters-header-actions">
            <label class="characters-search">
              <span aria-hidden="true">⌕</span>

              <input
                id="characters-search-input"
                type="search"
                placeholder="Rechercher un personnage, royaume..."
                autocomplete="off"
              />
            </label>

            <div class="battle-status" id="battleStatus">
              <span class="battle-status-icon" aria-hidden="true">✧</span>
              <span class="battle-status-copy">
                <b>Battle.net</b>
                <small id="battleStatusText">Connexion en cours...</small>
              </span>
              <i id="battleStatusDot"></i>
            </div>

            <button
              id="syncCharactersButton"
              class="characters-sync-button"
              type="button"
              aria-label="Synchroniser les personnages Battle.net"
              title="Synchroniser les personnages Battle.net"
            >
              <span class="characters-sync-icon" aria-hidden="true">↻</span>
              <span class="characters-sync-label">Synchroniser</span>
            </button>

            <button
              id="backToDashboardTop"
              class="characters-back-button"
              type="button"
              aria-label="Retour au carnet"
            >
              <span aria-hidden="true">←</span>
            </button>
          </div>
        </header>

        <div class="characters-toolbar">
          <div class="characters-filters">
            <button
              class="characters-filter active"
              type="button"
              data-faction-filter="all"
            >
              Tous
              <span id="characters-count">0</span>
            </button>

            <button
              class="characters-filter"
              type="button"
              data-faction-filter="ALLIANCE"
            >
              Alliance
            </button>

            <button
              class="characters-filter"
              type="button"
              data-faction-filter="HORDE"
            >
              Horde
            </button>
          </div>

          <span class="characters-help">
            <span class="characters-help-icon" aria-hidden="true">!</span>
            <span>Clique sur une carte pour voir ses détails</span>
          </span>
        </div>

        <div id="characters-list" class="characters-list">
          <div class="characters-loading">Chargement des personnages...</div>
        </div>
      </section>
    </section>

    <section
      id="characterProfileView"
      class="app-view character-profile-view"
      data-view="characterProfile"
      aria-hidden="true"
    >
      <section
        class="character-profile-panel"
        aria-labelledby="profileCharacterName"
      >
        <header class="character-profile-header">
          <div>
            <span class="character-profile-kicker">FICHE DU HÉROS</span>
            <h2 id="profileCharacterName">Personnage</h2>
            <p id="profileCharacterSubtitle">Profil Battle.net synchronisé</p>
          </div>

          <div class="character-profile-header-actions">
            <button
              id="selectProfileCharacter"
              class="select-character-button character-profile-select"
              type="button"
            >
              Choisir ce héros
            </button>

            <button
              id="backToCharacters"
              class="characters-back-button"
              type="button"
              aria-label="Retour au Hall des héros"
            >
              <span aria-hidden="true">←</span>
            </button>
          </div>
        </header>

        <div class="character-profile-content character-profile-content-armory">
          <div class="character-profile-details">
            <section
              class="character-profile-grid"
              aria-label="Résumé du personnage"
            >
              <article class="profile-fact profile-fact-level">
                <span class="profile-fact-icon profile-level-medallion" id="profileCharacterLevelIcon" aria-hidden="true">—</span>
                <span class="profile-fact-copy"><small>Niveau</small><strong id="profileCharacterLevel">—</strong></span>
              </article>

              <article class="profile-fact profile-fact-class">
                <span class="profile-fact-icon profile-wow-icon" id="profileCharacterClassFactIcon" aria-hidden="true"></span>
                <span class="profile-fact-copy"><small>Classe</small><strong id="profileCharacterClass">—</strong></span>
              </article>

              <article class="profile-fact profile-fact-race">
                <span class="profile-fact-icon profile-race-medallion" id="profileCharacterRaceIcon" aria-hidden="true"></span>
                <span class="profile-fact-copy"><small>Race</small><strong id="profileCharacterRace">—</strong></span>
              </article>

              <article class="profile-fact profile-fact-faction">
                <span class="profile-fact-icon profile-wow-icon" id="profileCharacterFactionFactIcon" aria-hidden="true"></span>
                <span class="profile-fact-copy"><small>Faction</small><strong id="profileCharacterFactionDetail">—</strong></span>
              </article>

              <article class="profile-fact profile-fact-realm">
                <span class="profile-fact-icon profile-wow-icon" id="profileCharacterRealmIcon" aria-hidden="true"></span>
                <span class="profile-fact-copy"><small>Royaume</small><strong id="profileCharacterRealm">—</strong></span>
              </article>

              <article class="profile-fact profile-fact-location">
                <span class="profile-fact-icon profile-wow-icon" id="profileCharacterLocationIcon" aria-hidden="true"></span>
                <span class="profile-fact-copy"><small>Localisation</small><strong id="profileCharacterLocation" class="character-profile-location">Non fournie par Battle.net</strong></span>
              </article>
            </section>

            <section class="hero-equipment-profile" aria-labelledby="heroEquipmentTitle">
              <header class="hero-equipment-header">
                <div>
                  <span class="hero-equipment-kicker">ARMURERIE DU HÉROS</span>
                  <h3 id="heroEquipmentTitle">Équipement</h3>
                </div>
                <div class="hero-equipment-score">
                  <span>Niveau d’objet</span>
                  <strong id="heroEquipmentItemLevel">—</strong>
                  <small id="heroEquipmentCount">0 pièce équipée</small>
                </div>
              </header>

              <div class="hero-equipment-layout">
                <div id="heroEquipmentLeft" class="hero-equipment-column hero-equipment-column-left" aria-label="Équipement gauche"></div>

                <article class="character-profile-hero hero-equipment-center" aria-label="Apparence du héros">
                  <div class="character-profile-portrait is-full-body">
                    <div class="character-profile-image-window">
                      <img id="profileCharacterImage" alt="" />
                    </div>
                  </div>

                  <span class="character-profile-image-hint">Molette : zoom · Glisser : déplacer · Double-clic : réinitialiser</span>
                </article>

                <div id="heroEquipmentRight" class="hero-equipment-column hero-equipment-column-right" aria-label="Équipement droit"></div>
                <div id="heroEquipmentWeapons" class="hero-equipment-weapons" aria-label="Armes"></div>
              </div>

              <div id="heroEquipmentTooltip" class="hero-equipment-tooltip" role="tooltip" hidden></div>
              <span id="heroEquipmentStatus" class="sr-only">Chargement de l’équipement...</span>
              <strong id="heroEquipmentCharacterName" class="sr-only">Héros</strong>
            </section>

            <section class="character-profile-sections">
              <article class="profile-progress-card profile-professions-card">
                <header class="profile-progress-header">
                  <span class="profile-progress-icon" aria-hidden="true">⚒</span>
                  <div>
                    <span class="profile-progress-kicker">PROGRESSION</span>
                    <h3>Métiers</h3>
                  </div>
                </header>
                <div
                  id="profileCharacterProfessions"
                  class="profile-professions-list"
                  aria-live="polite"
                >
                  <p class="profile-progress-empty">Chargement des métiers...</p>
                </div>
              </article>

              <article class="profile-progress-card profile-achievements-card">
                <header class="profile-progress-header">
                  <span class="profile-progress-icon" aria-hidden="true">🏆</span>
                  <div>
                    <span class="profile-progress-kicker">HAUTS FAITS</span>
                    <h3>Héritage</h3>
                  </div>
                </header>
                <div class="profile-progress-metrics" aria-label="Résumé des hauts faits">
                  <div>
                    <strong id="profileAchievementCount">—</strong>
                    <span>obtenus</span>
                  </div>
                  <div>
                    <strong id="profileAchievementPoints">—</strong>
                    <span>points</span>
                  </div>
                </div>
                <div id="profileAchievementRecent" class="profile-recent-list" aria-live="polite">
                  <p class="profile-progress-empty">Chargement des hauts faits...</p>
                </div>
              </article>

              <article class="profile-progress-card profile-collections-card">
                <header class="profile-progress-header">
                  <span class="profile-progress-icon" aria-hidden="true">🐴</span>
                  <div>
                    <span class="profile-progress-kicker">COMPTE</span>
                    <h3>Collections</h3>
                  </div>
                </header>
                <div class="profile-collection-grid" aria-label="Résumé des collections">
                  <div class="profile-collection-stat">
                    <span aria-hidden="true">♞</span>
                    <div><strong id="profileMountCount">—</strong><small>Montures</small></div>
                  </div>
                  <div class="profile-collection-stat">
                    <span aria-hidden="true">✦</span>
                    <div><strong id="profilePetCount">—</strong><small>Mascottes</small></div>
                  </div>
                </div>
                <p id="profileCollectionStatus" class="profile-collection-status" aria-live="polite">
                  Chargement des collections...
                </p>
                <div class="profile-collection-tabs" role="tablist" aria-label="Type de collection">
                  <button class="is-active" type="button" role="tab" aria-selected="true" aria-controls="profileCollectionList" data-profile-collection-tab="mounts">Montures</button>
                  <button type="button" role="tab" aria-selected="false" aria-controls="profileCollectionList" data-profile-collection-tab="pets">Mascottes</button>
                </div>
                <div id="profileCollectionList" class="profile-collection-list" aria-live="polite"></div>
                <nav id="profileCollectionPagination" class="profile-collection-pagination" aria-label="Pages de la collection" hidden></nav>
                <div id="profileCollectionTooltip" class="profile-collection-tooltip" role="tooltip" hidden></div>
                <div id="profileCollectionModal" class="profile-collection-modal" hidden>
                  <button class="profile-collection-modal-backdrop" type="button" aria-label="Fermer la fiche"></button>
                  <section class="profile-collection-modal-dialog" role="dialog" aria-modal="true" aria-labelledby="profileCollectionModalTitle">
                    <button id="profileCollectionModalClose" class="profile-collection-modal-close" type="button" aria-label="Fermer">×</button>
                    <div id="profileCollectionModalBody"></div>
                  </section>
                </div>
              </article>
            </section>
          </div>
        </div>
      </section>
    </section>
  </main>

  <footer class="app-footer">
    <span>◈ &nbsp; AZER COMPANION v1.1.2</span>
    <strong>Ton aventure. Ton histoire. Ton héritage.</strong>
    <span aria-hidden="true"></span>
  </footer>
</div>

<button
  class="mobile-menu-button"
  id="mobileMenuButton"
  type="button"
  aria-label="Ouvrir le menu"
>
  ☰
</button>

<%- include('components/compass/compass_menu') %> <%- include('partials/footer')
%>
