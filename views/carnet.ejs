<%- include('partials/header') %>

<div class="azer-shell">
    <aside class="side-menu" id="sideMenu">
        <div class="brand-block">
            <div class="brand-compass">✥</div>
            <div class="brand-kicker">DH STUDIO</div>
            <div class="brand-title">AZER</div>
            <div class="brand-subtitle">COMPANION</div>
            <div class="brand-tagline">POUR WORLD OF WARCRAFT</div>
        </div>

        <nav class="main-nav" aria-label="Navigation principale">
            <a href="#" class="nav-item active"><span>📖</span><b>Carnet d’aventure</b></a>
            <a href="#" class="nav-item"><span>🌍</span><b>Monde</b></a>
            <a href="#" class="nav-item"><span>⚔</span><b>Donjons</b></a>
            <a href="#" class="nav-item"><span>🏰</span><b>Raids</b></a>
            <a href="#" class="nav-item"><span>🐾</span><b>Mascottes</b></a>
            <a href="#" class="nav-item"><span>🦄</span><b>Familiers</b></a>
            <a href="#" class="nav-item"><span>🐴</span><b>Montures</b></a>
            <a href="#" class="nav-item"><span>🏆</span><b>Hauts faits</b></a>
            <a href="#" class="nav-item"><span>🧰</span><b>Collections</b></a>
            <a href="#" class="nav-item"><span>⚙</span><b>Paramètres</b></a>
        </nav>

        <div class="side-decoration">✥</div>
        <button class="character-switch" type="button">♟ <span>Changer de personnage</span></button>
    </aside>

    <main class="main-area">
        <section class="hero-area">
            <div class="hero-copy">
                <h1>Bon retour, OmbreLoup.</h1>
                <h2>Les Hinterlands t’attendent encore.</h2>
                <p>« Que l’aventure continue. »</p>
            </div>

            <div class="player-head">
                <div class="player-avatar">
                    <img src="/assets/avatar-ombreloup.png" alt="Portrait du personnage">
                </div>
                <div class="player-name">
                    <strong>OmbreLoup⌄</strong>
                    <span>Elfe de la nuit · <em>Chasseur</em></span>
                </div>
                <div class="player-level"><small>NIV.</small><b>47</b></div>
                <div class="hero-icon">✥</div>
                <div class="hero-icon bell">🔔<i>3</i></div>
                <div class="hero-icon">☾</div>
            </div>
        </section>

        <section class="content-grid">
            <div class="center-column">
                <div class="top-cards">
                    <article class="feature-card blue-card">
                        <div class="card-title">📍 <span>CHAPITRE ACTUEL</span></div>
                        <h3>Les Hinterlands</h3>
                        <img class="card-image" src="/assets/chapter-hinterlands.jpg" alt="Les Hinterlands">
                        <div class="chapter-row">
                            <span class="round-icon">☼</span>
                            <div><b>Chapitre 7</b><small>Les terres sauvages</small></div>
                        </div>
                        <div class="progress-row"><div class="progress-track"><i style="width:70%"></i></div><b>70%</b></div>
                        <button class="card-button">Voir le chapitre <span>📖</span></button>
                    </article>

                    <article class="feature-card green-card">
                        <div class="card-title">🎯 <span>PROCHAINE ÉTAPE</span></div>
                        <h3>Continue l’exploration</h3>
                        <ul class="detail-list">
                            <li><span>🗺️</span>8 quêtes t’attendent</li>
                            <li><span>🛡️</span>Visiter Zul’Farrak</li>
                            <li><span>🐾</span>Une mascotte t’attend</li>
                            <li><span>🧰</span>Découvrir 2 trésors</li>
                        </ul>
                        <button class="card-button">Voir les détails <span>›</span></button>
                    </article>

                    <article class="feature-card purple-card">
                        <div class="card-title">📖 <span>JOURNAL D’AVENTURE</span></div>
                        <h3>Ce qui s’est passé</h3>
                        <ul class="journal-list">
                            <li><span>✓</span><div><b>Hier</b><p>Zul’Gurub terminé</p><small>23 juillet 2026 · 21:48</small></div></li>
                            <li><span>✓</span><div><b>Niveau 47 atteint</b><small>23 juillet 2026 · 18:32</small></div></li>
                            <li><span>✓</span><div><b>Haut fait obtenu</b><p>Guerriers-esprits gurubashi</p><small>23 juillet 2026 · 17:15</small></div></li>
                        </ul>
                        <button class="card-button">Voir le journal <span>⚑</span></button>
                    </article>

                    <article class="feature-card gold-card">
                        <div class="card-title">⭐ <span>MON AVENTURE</span></div>
                        <h3>Ton résumé</h3>
                        <ul class="stats-list">
                            <li><span>◷</span><b>Temps de jeu</b><em>11 j 4 h</em></li>
                            <li><span>🎁</span><b>Quêtes terminées</b><em>726</em></li>
                            <li><span>🏆</span><b>Hauts faits</b><em>1 205</em></li>
                            <li><span>🐾</span><b>Mascottes</b><em>38 / 160</em></li>
                            <li><span>🐴</span><b>Montures</b><em>24 / 370</em></li>
                            <li><span>🏰</span><b>Donjons (Héroïque)</b><em>18 / 140</em></li>
                        </ul>
                        <button class="card-button">Voir toutes les stats <span>▥</span></button>
                    </article>
                </div>

                <section class="wide-panel today-panel">
                    <h3>À FAIRE AUJOURD’HUI</h3>
                    <div class="today-items">
                        <div><span>🗺️</span><b>Continuer les<br>Hinterlands</b></div>
                        <div><span>🛡️</span><b>Visiter<br>Zul’Farrak</b></div>
                        <div><span>🐾</span><b>Capturer<br>Suinteux de Jade</b></div>
                        <div><span>✥</span><b>Explorer de<br>nouveaux lieux</b></div>
                    </div>
                </section>

                <section class="wide-panel recent-panel">
                    <h3>ACTIVITÉS RÉCENTES</h3>
                    <div class="recent-items">
                        <div class="recent-entry"><span class="recent-icon green">✓</span><p>Vous avez terminé la quête :<b>L’ennemi intérieur</b><small>Aujourd’hui · 19:45</small></p></div>
                        <div class="recent-entry"><span class="recent-icon gold">☼</span><p>Vous avez obtenu le haut fait :<b>Zul’Gurub</b><small>Hier · 21:10</small></p></div>
                        <div class="recent-entry"><span class="recent-icon green">🐾</span><p>Vous avez capturé la mascotte :<b>Bébé singe</b><small>Hier · 17:33</small></p></div>
                        <button class="activity-button">⚡ Voir toutes les activités</button>
                    </div>
                </section>
            </div>

            <aside class="right-column">
                <article class="side-card quote-card">
                    <h3>CITATION DU JOUR</h3>
                    <blockquote>“ <span>Les Hinterlands cachent encore bien des secrets pour ceux qui prennent le temps de les chercher.</span></blockquote>
                    <div class="mini-compass">✥</div>
                </article>

                <article class="side-card destination-card">
                    <h3>PROCHAINE DESTINATION</h3>
                    <img src="/assets/map-hinterlands.jpg" alt="Carte des Hinterlands">
                    <h4>Les Hinterlands</h4>
                    <p>Continue ton exploration<br>et découvre tous ses secrets.</p>
                    <button class="card-button">Ouvrir la carte <span>📖</span></button>
                </article>

                <article class="side-card objective-card">
                    <h3>OBJECTIFS ACTIFS (3)</h3>
                    <div class="objective-item"><div><span>✥</span><b>Atteindre le niveau 50</b><em>47 / 50</em></div><div class="progress-track"><i style="width:94%"></i></div></div>
                    <div class="objective-item"><div><span>✦</span><b>Quêtes des Hinterlands</b><em>8 / 16</em></div><div class="progress-track"><i style="width:50%"></i></div></div>
                    <div class="objective-item"><div><span>✥</span><b>Capturer 10 nouvelles mascottes</b><em>6 / 10</em></div><div class="progress-track"><i style="width:60%"></i></div></div>
                    <button class="card-button">🎯 Voir tous les objectifs</button>
                </article>
            </aside>
        </section>

    </main>

    <footer class="app-footer">
        <span>◈ &nbsp; AZER COMPANION v0.1.0</span>
        <strong>Ton aventure. Ton histoire. Ton héritage.</strong>
        <span>Une création de <b>DH Studio</b></span>
    </footer>
</div>

<button class="mobile-menu-button" id="mobileMenuButton" type="button">☰</button>

<%- include('partials/footer') %>
