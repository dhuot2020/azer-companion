<header class="azer-topbar">
    <button class="mobile-menu" id="sidebarToggle">☰</button>
    <div class="character-head"><img src="/assets/avatar.jpg" alt="Portrait"><div><strong><%= current_character.name %>⌄</strong><span><%= current_character.race %> · <em><%= current_character.player_class %></em></span></div></div>
    <div class="level"><span>NIV.</span><strong><%= current_character.level %></strong></div>
    <button class="round-button">✥</button><button class="round-button badge">🔔<b>3</b></button><button class="round-button">☾</button>
</header>
