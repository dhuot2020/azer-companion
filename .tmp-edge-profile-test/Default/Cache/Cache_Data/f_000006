body.compass-menu-open {
  overflow: hidden;
}

.compass-menu {
  position: fixed;
  inset: 0;
  z-index: 9500;
  display: grid;
  place-items: center;
  padding: 18px;
  visibility: hidden;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.28s ease, visibility 0.28s ease;
}

.compass-menu.is-open {
  visibility: visible;
  opacity: 1;
  pointer-events: auto;
}

.compass-menu-overlay {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  padding: 0;
  border: 0;
  cursor: default;
  background:
    radial-gradient(circle at 50% 46%, rgba(32, 145, 194, 0.14), transparent 30%),
    radial-gradient(circle at 50% 55%, rgba(215, 155, 57, 0.055), transparent 42%),
    linear-gradient(180deg, rgba(1, 7, 13, 0.92), rgba(1, 5, 10, 0.97));
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
}

.compass-menu-panel {
  position: relative;
  z-index: 1;
  width: min(820px, calc(100vw - 36px));
  min-height: min(820px, calc(100vh - 36px));
  overflow: hidden;
  padding: 30px 36px 24px;
  border: 1px solid rgba(215, 155, 57, 0.68);
  border-radius: 18px;
  background:
    radial-gradient(ellipse at 50% 50%, rgba(20, 107, 150, 0.16) 0%, rgba(7, 38, 59, 0.07) 29%, transparent 58%),
    radial-gradient(ellipse at 50% 62%, rgba(215, 155, 57, 0.045), transparent 48%),
    linear-gradient(145deg, #061827 0%, #03111d 48%, #010912 100%);
  box-shadow:
    0 34px 110px rgba(0, 0, 0, 0.78),
    inset 0 0 110px rgba(22, 105, 153, 0.07),
    inset 0 0 36px rgba(0, 0, 0, 0.34),
    0 0 38px rgba(45, 215, 255, 0.07);
  transform: scale(0.92) translateY(18px);
  transition: transform 0.36s cubic-bezier(0.18, 0.8, 0.22, 1);
}

.compass-menu-panel::before,
.compass-menu-panel::after {
  content: "";
  position: absolute;
  width: 70px;
  height: 70px;
  pointer-events: none;
}

.compass-menu-panel::before {
  top: 14px;
  left: 14px;
  border-top: 1px solid rgba(244, 202, 116, 0.68);
  border-left: 1px solid rgba(244, 202, 116, 0.68);
  border-radius: 12px 0 0;
}

.compass-menu-panel::after {
  right: 14px;
  bottom: 14px;
  border-right: 1px solid rgba(244, 202, 116, 0.68);
  border-bottom: 1px solid rgba(244, 202, 116, 0.68);
  border-radius: 0 0 12px;
}

.compass-menu.is-open .compass-menu-panel {
  transform: scale(1) translateY(0);
}

.compass-menu-glow {
  position: absolute;
  left: 50%;
  top: 52%;
  width: 610px;
  height: 610px;
  pointer-events: none;
  transform: translate(-50%, -50%);
  background:
    radial-gradient(circle, rgba(35, 176, 224, 0.08), transparent 29%),
    radial-gradient(circle, transparent 31%, rgba(19, 97, 136, 0.04) 48%, transparent 69%);
  filter: blur(20px);
  opacity: 0.9;
}

.compass-menu-heading {
  position: relative;
  z-index: 3;
  text-align: center;
}

.compass-menu-kicker {
  color: #e9bd68;
  font-family: "Orbitron", sans-serif;
  font-size: 9px;
  font-weight: 600;
  letter-spacing: 0.25em;
}

.compass-menu-heading h2 {
  margin: 7px 0 3px;
  color: #f4ca74;
  font-family: "Cinzel", Georgia, serif;
  font-size: clamp(29px, 4vw, 43px);
  font-weight: 500;
  letter-spacing: 0.055em;
  text-transform: uppercase;
  text-shadow: 0 2px 0 #4a2507, 0 0 18px rgba(215, 155, 57, 0.18);
}

.compass-menu-heading p {
  margin: 0;
  color: rgba(226, 234, 235, 0.66);
  font-size: 14px;
  font-style: italic;
}

.compass-wheel {
  position: relative;
  width: min(570px, 72vw);
  aspect-ratio: 1;
  margin: 20px auto 8px;
}

.compass-energy-field {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 76%;
  height: 76%;
  pointer-events: none;
  transform: translate(-50%, -50%);
  border-radius: 50%;
  background:
    radial-gradient(circle, rgba(45, 215, 255, 0.055) 0%, transparent 35%),
    conic-gradient(from 15deg, transparent, rgba(45, 215, 255, 0.025), transparent 18%, rgba(215, 155, 57, 0.02), transparent 44%);
  filter: blur(18px);
  opacity: 0.72;
  animation: compass-field-breathe 7s ease-in-out infinite;
}

.compass-action {
  --x: 0px;
  --y: 0px;
  --delay: 0s;
  --ray-angle: 0deg;
  --ray-left: 50%;
  --ray-top: 50%;
  --ray-length: 80px;
  position: absolute;
  z-index: 4;
  left: 50%;
  top: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6px;
  width: 108px;
  min-height: 86px;
  padding: 9px 8px;
  color: #f3eadc;
  text-decoration: none;
  border: 1px solid rgba(205, 145, 44, 0.76);
  border-radius: 10px;
  background:
    linear-gradient(145deg, rgba(255, 255, 255, 0.035), transparent 34%),
    radial-gradient(circle at 50% 16%, rgba(31, 133, 183, 0.16), transparent 56%),
    linear-gradient(180deg, rgba(9, 38, 58, 0.98), rgba(3, 18, 29, 0.99));
  box-shadow:
    inset 0 0 0 1px rgba(255, 228, 167, 0.025),
    inset 0 0 20px rgba(21, 106, 153, 0.09),
    0 11px 22px rgba(0, 0, 0, 0.32);
  opacity: 0;
  transform: translate(calc(-50% + var(--x)), calc(-50% + var(--y))) scale(0.55);
  transition:
    opacity 0.25s ease var(--delay),
    transform 0.42s cubic-bezier(0.18, 0.82, 0.24, 1) var(--delay),
    border-color 0.18s ease,
    box-shadow 0.18s ease,
    background 0.18s ease,
    color 0.18s ease;
}

.compass-menu.is-open .compass-action {
  opacity: 1;
  transform: translate(calc(-50% + var(--x)), calc(-50% + var(--y))) scale(1);
}

.compass-action::before,
.compass-action::after {
  content: "";
  position: absolute;
  width: 9px;
  height: 9px;
  border: 1px solid rgba(225, 166, 68, 0.72);
  background: rgba(4, 21, 33, 0.96);
  transform: rotate(45deg);
  transition: border-color 0.18s ease, box-shadow 0.18s ease, background 0.18s ease;
}

.compass-action::before {
  left: 7px;
  top: 7px;
}

.compass-action::after {
  right: 7px;
  bottom: 7px;
}

.compass-action-ray {
  position: absolute;
  z-index: -1;
  left: var(--ray-left);
  top: var(--ray-top);
  width: var(--ray-length);
  height: 2px;
  overflow: visible;
  pointer-events: none;
  transform: rotate(var(--ray-angle));
  transform-origin: 0 50%;
  opacity: 0.28;
}

.compass-action-ray::before {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(90deg, rgba(215, 155, 57, 0.24), rgba(45, 215, 255, 0.10), transparent 92%);
  transform-origin: left center;
  transition: opacity 0.2s ease, filter 0.2s ease, box-shadow 0.2s ease;
}

.compass-action-ray i {
  position: absolute;
  left: 0;
  top: 50%;
  width: 34px;
  height: 4px;
  border-radius: 999px;
  background: linear-gradient(90deg, transparent, #fff6c3 38%, #ffc95e 68%, transparent);
  filter: blur(0.2px) drop-shadow(0 0 5px rgba(255, 193, 73, 0.9));
  opacity: 0;
  transform: translateY(-50%);
}

.compass-action-north { --x: 0px; --y: -214px; --delay: 0.02s; --ray-angle: 90deg; --ray-left: 50%; --ray-top: 100%; --ray-length: 91px; }
.compass-action-north-east { --x: 153px; --y: -153px; --delay: 0.05s; --ray-angle: 135deg; --ray-left: 10.2%; --ray-top: 100%; --ray-length: 77px; }
.compass-action-east { --x: 214px; --y: 0px; --delay: 0.08s; --ray-angle: 180deg; --ray-left: 0%; --ray-top: 50%; --ray-length: 80px; }
.compass-action-south-east { --x: 153px; --y: 153px; --delay: 0.11s; --ray-angle: 225deg; --ray-left: 10.2%; --ray-top: 0%; --ray-length: 77px; }
.compass-action-south { --x: 0px; --y: 214px; --delay: 0.14s; --ray-angle: 270deg; --ray-left: 50%; --ray-top: 0%; --ray-length: 91px; }
.compass-action-south-west { --x: -153px; --y: 153px; --delay: 0.17s; --ray-angle: 315deg; --ray-left: 89.8%; --ray-top: 0%; --ray-length: 77px; }
.compass-action-west { --x: -214px; --y: 0px; --delay: 0.2s; --ray-angle: 0deg; --ray-left: 100%; --ray-top: 50%; --ray-length: 80px; }
.compass-action-north-west { --x: -153px; --y: -153px; --delay: 0.23s; --ray-angle: 45deg; --ray-left: 89.8%; --ray-top: 100%; --ray-length: 77px; }

.compass-action:hover,
.compass-action:focus-visible,
.compass-action.is-active,
.compass-action.is-launching {
  color: #fff;
  border-color: rgba(255, 215, 132, 1);
  outline: none;
  background:
    linear-gradient(145deg, rgba(255, 255, 255, 0.07), transparent 32%),
    radial-gradient(circle at 50% 18%, rgba(45, 215, 255, 0.27), transparent 58%),
    linear-gradient(180deg, rgba(14, 57, 83, 0.99), rgba(4, 24, 38, 0.99));
  box-shadow:
    inset 0 0 0 1px rgba(255, 228, 167, 0.08),
    inset 0 0 28px rgba(45, 215, 255, 0.12),
    0 0 11px rgba(45, 215, 255, 0.09),
    0 0 13px rgba(215, 155, 57, 0.11),
    0 15px 26px rgba(0, 0, 0, 0.38);
  transform: translate(calc(-50% + var(--x)), calc(-50% + var(--y))) scale(1.08);
}

.compass-action:hover::before,
.compass-action:hover::after,
.compass-action:focus-visible::before,
.compass-action:focus-visible::after,
.compass-action.is-active::before,
.compass-action.is-active::after,
.compass-action.is-launching::before,
.compass-action.is-launching::after {
  border-color: #fff0bd;
  background: radial-gradient(circle, #fff4c8 0 18%, #b87a24 24% 58%, #4b3012 72%);
  box-shadow:
    0 0 7px rgba(255, 213, 117, 0.72),
    0 0 13px rgba(255, 182, 54, 0.34);
}

.compass-action.is-active .compass-action-ray,
.compass-action.is-launching .compass-action-ray {
  opacity: 1;
}

.compass-action.is-active .compass-action-ray::before,
.compass-action.is-launching .compass-action-ray::before {
  background: linear-gradient(90deg, #fff0ab, #f2b43e 38%, rgba(45, 215, 255, 0.6) 72%, transparent 100%);
  box-shadow: 0 0 7px rgba(255, 197, 81, 0.9), 0 0 16px rgba(45, 215, 255, 0.34);
  filter: brightness(1.35);
}

.compass-action.is-active .compass-action-ray i,
.compass-action.is-launching .compass-action-ray i {
  opacity: 1;
  animation: compass-energy-travel 0.72s linear infinite;
}





.compass-action-icon {
  display: grid;
  place-items: center;
  width: 34px;
  height: 34px;
  color: #efc46d;
  filter: drop-shadow(0 2px 3px rgba(0, 0, 0, 0.82));
  transition: color 0.2s ease, filter 0.2s ease, transform 0.2s ease;
}

.compass-action-icon svg {
  width: 29px;
  height: 29px;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.65;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.compass-action:hover .compass-action-icon,
.compass-action:focus-visible .compass-action-icon,
.compass-action.is-active .compass-action-icon,
.compass-action.is-launching .compass-action-icon {
  color: #fff1af;
  filter: drop-shadow(0 0 7px rgba(45, 215, 255, 0.56)) drop-shadow(0 0 8px rgba(255, 192, 64, 0.28));
  transform: translateY(-2px);
}

.compass-action-label {
  color: #f1c96e;
  font-family: "Cinzel", Georgia, serif;
  font-size: 13px;
  font-weight: 600;
  line-height: 1.05;
  text-align: center;
  text-transform: uppercase;
  text-shadow: 0 1px 2px #000;
}

.compass-core {
  position: absolute;
  z-index: 7;
  left: 50%;
  top: 50%;
  display: grid;
  place-items: center;
  width: 158px;
  height: 158px;
  padding: 0;
  color: #e9bd68;
  border: 1px solid rgba(215, 155, 57, 0.72);
  border-radius: 50%;
  cursor: pointer;
  background: radial-gradient(circle, rgba(10, 42, 61, 0.94), rgba(2, 14, 23, 0.99) 69%);
  box-shadow:
    0 0 0 8px rgba(2, 14, 23, 0.8),
    0 0 0 9px rgba(215, 155, 57, 0.24),
    inset 0 0 24px rgba(45, 215, 255, 0.08),
    0 13px 28px rgba(0, 0, 0, 0.44);
  transform: translate(-50%, -50%);
  transition: transform 0.22s ease, box-shadow 0.22s ease;
}

.compass-core:hover,
.compass-core:focus-visible {
  outline: none;
  transform: translate(-50%, -50%) scale(1.04);
  box-shadow:
    0 0 0 8px rgba(2, 14, 23, 0.84),
    0 0 0 9px rgba(244, 202, 116, 0.48),
    0 0 24px rgba(45, 215, 255, 0.2),
    inset 0 0 28px rgba(45, 215, 255, 0.12),
    0 15px 30px rgba(0, 0, 0, 0.46);
}

.compass-core-halo {
  position: absolute;
  inset: -15px;
  border: 1px solid rgba(45, 215, 255, 0.12);
  border-radius: 50%;
  animation: compass-core-pulse 3.5s ease-in-out infinite;
}

.compass-core-ring {
  position: absolute;
  inset: 8px;
  border: 1px solid rgba(244, 202, 116, 0.24);
  border-radius: 50%;
}

.compass-core img {
  width: 104px;
  height: 104px;
  object-fit: contain;
  filter: drop-shadow(0 3px 5px rgba(0, 0, 0, 0.9)) drop-shadow(0 0 9px rgba(215, 155, 57, 0.28));
  transform: rotate(var(--compass-rotation, 0deg));
  transition: transform 0.34s cubic-bezier(0.2, 0.78, 0.24, 1), filter 0.2s ease;
}

.compass-wheel[data-active] .compass-core,
.compass-wheel.is-launching .compass-core {
  box-shadow:
    0 0 0 8px rgba(2, 14, 23, 0.84),
    0 0 0 9px rgba(244, 202, 116, 0.5),
    0 0 24px rgba(45, 215, 255, 0.22),
    0 0 34px rgba(215, 155, 57, 0.16),
    inset 0 0 30px rgba(45, 215, 255, 0.14),
    0 15px 30px rgba(0, 0, 0, 0.46);
}

.compass-wheel[data-active] .compass-core img,
.compass-wheel.is-launching .compass-core img {
  transform: rotate(var(--compass-rotation, 0deg)) scale(1.04);
  filter: drop-shadow(0 3px 5px rgba(0, 0, 0, 0.9)) drop-shadow(0 0 13px rgba(45, 215, 255, 0.42)) drop-shadow(0 0 12px rgba(255, 188, 57, 0.24));
}

.compass-wheel.is-launching .compass-core {
  animation: compass-core-launch 0.42s ease-out both;
}

.compass-core-text {
  position: absolute;
  left: 50%;
  bottom: -27px;
  color: rgba(233, 189, 104, 0.78);
  font-family: "Orbitron", sans-serif;
  font-size: 8px;
  letter-spacing: 0.22em;
  transform: translateX(-50%);
}

.compass-menu-footer {
  position: relative;
  z-index: 3;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
  min-height: 48px;
  margin-top: 4px;
  padding: 12px 0 0;
  color: rgba(209, 222, 226, 0.48);
  border-top: 1px solid rgba(215, 155, 57, 0.18);
  font-size: 11px;
}

.compass-menu-footer strong {
  color: #79d9f5;
  font-weight: 400;
  text-align: right;
  transition: color 0.2s ease, text-shadow 0.2s ease;
}

.compass-wheel[data-active] + .compass-menu-footer strong {
  color: #ffe1a0;
  text-shadow: 0 0 8px rgba(255, 189, 65, 0.42);
}

@keyframes compass-field-breathe {
  0%, 100% { opacity: 0.52; transform: translate(-50%, -50%) scale(0.97); }
  50% { opacity: 0.82; transform: translate(-50%, -50%) scale(1.045); }
}

@keyframes compass-core-pulse {
  0%, 100% { opacity: 0.28; transform: scale(0.98); }
  50% { opacity: 0.68; transform: scale(1.035); }
}

@keyframes compass-energy-travel {
  from { transform: translate(0, -50%); }
  to { transform: translate(156px, -50%); }
}


@keyframes compass-core-launch {
  0% { transform: translate(-50%, -50%) scale(1.02); }
  55% { transform: translate(-50%, -50%) scale(1.09); }
  100% { transform: translate(-50%, -50%) scale(1.04); }
}

@media (max-width: 720px) {
  .compass-menu { padding: 8px; }
  .compass-menu-panel { width: calc(100vw - 16px); min-height: calc(100vh - 16px); padding: 24px 12px 18px; border-radius: 13px; }
  .compass-menu-heading h2 { font-size: 28px; }
  .compass-wheel { width: min(470px, 92vw); margin-top: 18px; }
  .compass-action { width: 88px; min-height: 72px; padding: 7px 5px; }
  .compass-action-north { --y: -174px; }
  .compass-action-north-east { --x: 124px; --y: -124px; }
  .compass-action-east { --x: 174px; }
  .compass-action-south-east { --x: 124px; --y: 124px; }
  .compass-action-south { --y: 174px; }
  .compass-action-south-west { --x: -124px; --y: 124px; }
  .compass-action-west { --x: -174px; }
  .compass-action-north-west { --x: -124px; --y: -124px; }
  .compass-action-label { font-size: 10px; }
  .compass-action-icon svg { width: 24px; height: 24px; }
  .compass-core { width: 124px; height: 124px; }
  .compass-core img { width: 82px; height: 82px; }
  .compass-action-ray { width: var(--ray-length); }
  @keyframes compass-energy-travel { from { transform: translate(0, -50%); } to { transform: translate(122px, -50%); } }
}

@media (max-width: 480px) {
  .compass-menu-heading p { font-size: 12px; }
  .compass-menu-kicker { font-size: 7px; }
  .compass-wheel { width: 360px; max-width: 94vw; }
  .compass-action { width: 74px; min-height: 62px; border-radius: 8px; }
  .compass-action-north { --y: -135px; }
  .compass-action-north-east { --x: 96px; --y: -96px; }
  .compass-action-east { --x: 135px; }
  .compass-action-south-east { --x: 96px; --y: 96px; }
  .compass-action-south { --y: 135px; }
  .compass-action-south-west { --x: -96px; --y: 96px; }
  .compass-action-west { --x: -135px; }
  .compass-action-north-west { --x: -96px; --y: -96px; }
  .compass-action-icon { width: 26px; height: 26px; }
  .compass-action-icon svg { width: 21px; height: 21px; }
  .compass-action-label { font-size: 8px; }
  .compass-core { width: 104px; height: 104px; }
  .compass-core img { width: 68px; height: 68px; }
  .compass-core-text { bottom: -22px; font-size: 7px; }
  .compass-menu-footer { font-size: 9px; }
  .compass-action-ray { width: var(--ray-length); }
  @keyframes compass-energy-travel { from { transform: translate(0, -50%); } to { transform: translate(92px, -50%); } }
}

@media (prefers-reduced-motion: reduce) {
  .compass-energy-field,
  .compass-core-halo,
  .compass-action-ray i,
  .compass-wheel.is-launching .compass-core {
    animation: none !important;
  }

  .compass-menu-panel,
  .compass-action,
  .compass-core,
  .compass-core img {
    transition-duration: 0.01ms !important;
  }
}
